<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Web Suite"
       parallel="tests"
       thread-count="3"
       verbose="2">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.RetryTransformer"/>
    </listeners>

    <test name="Web Tests - Chrome">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="web"/>
            </run>
        </groups>
        <classes>
            <class name="com.tests.web.LoginTest"/>
        </classes>
    </test>

    <test name="Web Tests - Firefox">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="web"/>
            </run>
        </groups>
        <classes>
            <class name="com.tests.web.LoginTest"/>
        </classes>
    </test>

    <test name="Web Tests - Edge">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="web"/>
            </run>
        </groups>
        <classes>
            <class name="com.tests.web.LoginTest"/>
        </classes>
    </test>

</suite>
